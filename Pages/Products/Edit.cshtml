@page
@model wt_lab5_5razor_ageyavich.Pages.Products.EditModel

<div class="container py-4">
    <div class="card shadow-sm rounded-4 col-lg-8 mx-auto">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-4">Редактирование</h2>
            <form method="post">
                <input type="hidden" asp-for="Product.Id" />
                
                <div class="mb-3">
                    <label asp-for="Product.Name" class="form-label">Название</label>
                    <input asp-for="Product.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Product.Price" class="form-label">Цена</label>
                    <input asp-for="Product.Price" class="form-control" />
                </div>
                
                <button type="submit" class="btn btn-warning">💾 Обновить</button>
                <a asp-page="/Products/Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>