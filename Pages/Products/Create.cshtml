@page
@model wt_lab5_5razor_ageyavich.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Добавление";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Добавление товара</h2>
                    
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Product.Name" class="form-label">Название</label>
                            <input asp-for="Product.Name" class="form-control" />
                            <span asp-validation-for="Product.Name" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Product.Category" class="form-label">Категория</label>
                            <input asp-for="Product.Category" class="form-control" />
                            <span asp-validation-for="Product.Category" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Product.Price" class="form-label">Цена</label>
                            <input asp-for="Product.Price" class="form-control" />
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Product.IsAvailable" class="form-check-input" />
                            <label asp-for="Product.IsAvailable" class="form-check-label">В наличии</label>
                        </div>

                        <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                        <a asp-page="/Products/Index" class="btn btn-secondary">Назад</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}